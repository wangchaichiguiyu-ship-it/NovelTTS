# =============================================================================
# .gitignore —— NovelTTS
# =============================================================================
# 原则：**只提交源码、配置、测试与文档；不提交任何"可再生成的产物"与"大二进制"。**
#
# 判断标准（按优先级）：
#   1. 能用命令重新生成的（缓存、编译产物、中间 JSON）-> 忽略
#   2. 体积大且能从外部获取的（模型权重）-> 忽略，用文档写清下载方式
#   3. 体积大但**是复现所必需**的（参考音频）-> 提交，并在文档里说明体积
#   4. 第三方版权素材（小说原文）-> 忽略，避免随仓库扩散
#
# ⚠️ 注意：.gitignore **不支持行尾注释**！
#    `output/   # 注释` 会被当成"路径里含 # 注释"的字面量，规则直接失效。
#    注释必须单独成行。这是实际踩过的坑。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 本项目的产物（全部可重新生成）
# -----------------------------------------------------------------------------
# 解析结果、片段音频、章节音频、压缩档，以及其中的 manifest.json / chapters.json
output/
output/**

*.m4a
*.mp3
*.opus
*.flac
*.aac

# 音频：默认忽略，但参考音频必须入库（复现音色所必需，且体积极小）
*.wav
!assets/ref/*.wav
!assets/ref/**/*.wav


# -----------------------------------------------------------------------------
# 2. 小说原文（第三方版权内容，不应随仓库扩散）
# -----------------------------------------------------------------------------
# sources/ 目录本身用 .gitkeep 与 README.md 保留，书由使用者自行放入
sources/*
!sources/.gitkeep
!sources/README.md


# -----------------------------------------------------------------------------
# 3. 模型权重（数 GB，从 HuggingFace / ModelScope 下载）
# -----------------------------------------------------------------------------
Qwen3-TTS-12Hz-1.7B-Base/
Qwen3-TTS-12Hz-0.6B-Base/
Qwen3-TTS-Tokenizer-12Hz/
Qwen3-TTS-*/

*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf


# -----------------------------------------------------------------------------
# 4. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# 虚拟环境
.venv/
venv/
env/
ENV/
.conda/

# 测试 / Lint 缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/


# -----------------------------------------------------------------------------
# 5. 本地工具缓存（可再生成，且往往是机器相关的）
# -----------------------------------------------------------------------------
.graphflow-cache/
graphflow-out/
.numba_cache/
*.numba_cache


# -----------------------------------------------------------------------------
# 6. 编辑器 / 操作系统
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.idea/
*.swp
*.swo
*~

# VSCode：只保留"团队共享"的配置，个人设置与临时脚本不入库
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json


# -----------------------------------------------------------------------------
# 7. 会话临时文件 / 日志
# -----------------------------------------------------------------------------
:memory:*
*.ses
*.log
nohup.out
run.log


# -----------------------------------------------------------------------------
# 8. 云端部署临时产物
# -----------------------------------------------------------------------------
*.tar.gz
*.zip

# 远程访问专用密钥（绝不入库）
.remote-key/
